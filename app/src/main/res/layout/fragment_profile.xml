<?xml version="1.0" encoding="utf-8"?>
<!--ScrollView enables scrolling when screen size is too small-->
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@drawable/background">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fitsSystemWindows="true"
        android:padding="16dp"
        tools:context=".ProfileFragment">

        <!-- Settings Button -->
        <ImageButton
            android:id="@+id/settingsButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:layout_marginEnd="15dp"
            android:layout_marginTop="10dp"
            android:background="@android:color/transparent"
            android:contentDescription="Settings"
            android:scaleType="fitCenter"
            android:src="@drawable/settings_icon"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Profile Picture -->
        <de.hdodenhof.circleimageview.CircleImageView
            android:id="@+id/profilePicImageView"
            android:layout_width="110dp"
            android:layout_height="110dp"
            android:layout_marginTop="80dp"
            android:elevation="4dp"
            android:contentDescription="Profile Picture"
            android:src="@drawable/profile_pic_example"
            app:civ_border_color="@color/white"
            app:civ_border_width="3dp"
            app:layout_constraintHorizontal_bias="0.5"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Edit Profile Button -->
        <ImageButton
            android:id="@+id/editProfileButton"
            android:layout_width="36dp"
            android:layout_height="36dp"
            android:background="@android:color/transparent"
            android:contentDescription="Edit Profile"
            android:scaleType="fitCenter"
            android:src="@drawable/edit_icon"
            app:layout_constraintBottom_toBottomOf="@id/profilePicImageView"
            app:layout_constraintEnd_toEndOf="@id/profilePicImageView"
            android:layout_marginEnd="-15dp"
            android:layout_marginBottom="-12dp"/>

        <!-- Followers and Following Section -->
        <LinearLayout
            android:id="@+id/followSection"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="10dp"
            app:layout_constraintTop_toBottomOf="@id/editProfileButton"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                android:id="@+id/textViewFollowers"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Followers"
                android:textSize="16sp"
                android:textColor="@android:color/white"
                android:paddingEnd="20dp"/>

            <TextView
                android:id="@+id/textViewFollowing"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Following"
                android:textSize="16sp"
                android:textColor="@android:color/white"/>
        </LinearLayout>

        <!-- Display Name Field -->
        <TextView
            android:id="@+id/textViewDisplayName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Display Name"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@android:color/white"
            android:gravity="center"
            app:layout_constraintTop_toBottomOf="@id/followSection"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- Bio -->
        <TextView
            android:id="@+id/textViewBio"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="bio goes here"
            android:textSize="12sp"
            android:textColor="@android:color/white"
            android:gravity="center"
            android:layout_marginTop="6dp"
            app:layout_constraintTop_toBottomOf="@id/textViewDisplayName"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintWidth_percent="0.5"/>

        <!-- Spotify Button -->
        <Button
            android:id="@+id/buttonProfileSpotify"
            android:layout_width="110dp"
            android:layout_height="40dp"
            android:layout_marginTop="10dp"
            android:backgroundTint="@color/spotify2"
            android:textColor="@color/black"
            android:text="Spotify"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/textViewBio"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintHorizontal_bias="0.5"
            app:layout_constraintWidth_percent="0.25"/>

        <!-- Song of the Day STARTS-->
        <LinearLayout
            android:id="@+id/containerSongOfTheDay"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="8dp"
            android:layout_marginTop="10dp"
            app:layout_constraintTop_toBottomOf="@id/buttonProfileSpotify"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintWidth_percent="0.875">

            <!-- Text Information -->
            <LinearLayout
                android:layout_height="wrap_content"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_height="wrap_content"
                    android:layout_width="wrap_content"
                    android:text="Song of the Day"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@android:color/white"/>

                <TextView
                    android:id="@+id/textViewSongOfTheDayArtist"
                    android:layout_height="wrap_content"
                    android:layout_width="wrap_content"
                    android:text="Mac Miller"
                    android:textSize="14sp"
                    android:textColor="@android:color/white"
                    android:gravity="center"/>
                <TextView
                    android:id="@+id/textViewSongOfTheDaySong"
                    android:layout_height="wrap_content"
                    android:layout_width="wrap_content"
                    android:text="Jet Fuel"
                    android:textSize="14sp"
                    android:textColor="@android:color/white"
                    android:gravity="center"/>
            </LinearLayout>

            <!-- Album Cover Image -->
            <ImageView
                android:id="@+id/songOfTheDayAlbumCover"
                android:layout_width="55dp"
                android:layout_height="55dp"
                android:src="@drawable/song_example"
                android:layout_gravity="center_vertical"
                android:layout_marginRight="20dp"/>
        </LinearLayout>
        <!-- Song of the Day ENDS-->


        <!-- Currently Playing STARTS-->
        <LinearLayout
            android:id="@+id/containerCurrentlyPlaying"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="8dp"
            android:layout_marginTop="10dp"
            app:layout_constraintTop_toBottomOf="@id/containerSongOfTheDay"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintWidth_percent="0.875">

            <!-- Text Information -->
            <LinearLayout
                android:layout_height="wrap_content"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_height="wrap_content"
                    android:layout_width="wrap_content"
                    android:text="Currently Playing"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@android:color/white"/>

                <TextView
                    android:id="@+id/textViewCurrentlyPlayingArtist"
                    android:layout_height="wrap_content"
                    android:layout_width="wrap_content"
                    android:text="Feid"
                    android:textSize="14sp"
                    android:textColor="@android:color/white"/>
                <TextView
                    android:id="@+id/textViewCurrentlyPlayingSong"
                    android:layout_height="wrap_content"
                    android:layout_width="wrap_content"
                    android:text="FELIZ CUMPLEAÑOS FERXXO"
                    android:textSize="14sp"
                    android:textColor="@android:color/white"/>
            </LinearLayout>

            <!-- Album Cover Image -->
            <ImageView
                android:id="@+id/currentlyPlayingAlbumCover"
                android:layout_width="55dp"
                android:layout_height="55dp"
                android:src="@drawable/currently_example"
                android:layout_gravity="center_vertical"
                android:layout_marginRight="20dp"/>
        </LinearLayout>
        <!-- Currently Playing ENDS-->


        <!-- Top 3 Songs & Artists START -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="16dp"
            app:layout_constraintTop_toBottomOf="@id/containerCurrentlyPlaying"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <!-- Top 3 Songs START -->
            <LinearLayout
                android:id="@+id/containerTopSongs"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:layout_height="wrap_content"
                    android:layout_width="wrap_content"
                    android:text="Top 3 Songs"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@android:color/white"/>

                <!--1st song START-->
                <LinearLayout
                    android:id="@+id/song1Container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="8dp">

                    <TextView
                        android:id="@+id/song1Title"
                        android:layout_height="wrap_content"
                        android:layout_width="wrap_content"
                        android:text="Hate CD"
                        android:textStyle="bold"
                        android:textSize="16sp"
                        android:textColor="@android:color/white"/>
                    <TextView
                        android:id="@+id/song1Artist"
                        android:layout_height="wrap_content"
                        android:layout_width="wrap_content"
                        android:text="Steve Lacy"
                        android:textSize="14sp"
                        android:textColor="@android:color/white"/>
                </LinearLayout>
                <!--1st song END-->


                <!--2nd song START-->
                <LinearLayout
                    android:id="@+id/song2Container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="8dp">
                    <TextView
                        android:id="@+id/song2Title"
                        android:layout_height="wrap_content"
                        android:layout_width="wrap_content"
                        android:text="PRIDE."
                        android:textStyle="bold"
                        android:textSize="16sp"
                        android:textColor="@android:color/white"/>
                    <TextView
                        android:id="@+id/song2Artist"
                        android:layout_height="wrap_content"
                        android:layout_width="wrap_content"
                        android:text="Kendrick Lamar"
                        android:textSize="14sp"
                        android:textColor="@android:color/white"/>
                </LinearLayout>
                <!--2nd song END-->


                <!--3rd song START-->
                <LinearLayout
                    android:id="@+id/song3Container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:padding="8dp">
                    <TextView
                        android:id="@+id/song3Title"
                        android:layout_height="wrap_content"
                        android:layout_width="wrap_content"
                        android:text="Face to Face"
                        android:textStyle="bold"
                        android:textSize="16sp"
                        android:textColor="@android:color/white"/>
                    <TextView
                        android:id="@+id/song3Artist"
                        android:layout_height="wrap_content"
                        android:layout_width="wrap_content"
                        android:text="Daft Punk"
                        android:textSize="14sp"
                        android:textColor="@android:color/white"/>
                </LinearLayout>
                <!--3rd song END-->
            </LinearLayout>
            <!-- Top 3 Songs END -->

            <!--**********************-->
            <!-- Top 3 Artists START -->
            <LinearLayout
                android:id="@+id/containerTopArtists"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:padding="12dp">

                <TextView
                    android:layout_height="wrap_content"
                    android:layout_width="wrap_content"
                    android:text="Top 3 Artists"
                    android:textSize="18sp"
                    android:textStyle="bold"
                    android:textColor="@android:color/white"/>

                <!--1st Artist START-->
                <LinearLayout
                    android:id="@+id/artist1Container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="8dp">

                    <de.hdodenhof.circleimageview.CircleImageView
                        android:id="@+id/artist1Pic"
                        android:layout_width="50dp"
                        android:layout_height="50dp"
                        android:src="@drawable/profile_pic_placeholder"
                        app:civ_border_color="@android:color/white"
                        app:civ_border_width="2dp"/>

                    <TextView
                        android:id="@+id/artist1Name"
                        android:layout_height="wrap_content"
                        android:layout_width="wrap_content"
                        android:layout_marginStart="12dp"
                        android:text="Tyler, The Creator"
                        android:textSize="14sp"
                        android:textColor="@android:color/white"
                        android:gravity="center_vertical"/>
                </LinearLayout>
                <!--1st Artist END-->


                <!--2nd Artist START-->
                <LinearLayout
                    android:id="@+id/artist2Container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="8dp">

                    <de.hdodenhof.circleimageview.CircleImageView
                        android:id="@+id/artist2Pic"
                        android:layout_width="50dp"
                        android:layout_height="50dp"
                        android:src="@drawable/profile_pic_placeholder"
                        app:civ_border_color="@android:color/white"
                        app:civ_border_width="2dp"/>

                    <TextView
                        android:id="@+id/artist2Name"
                        android:layout_height="wrap_content"
                        android:layout_width="wrap_content"
                        android:layout_marginStart="12dp"
                        android:text="The Killers"
                        android:textSize="14sp"
                        android:textColor="@android:color/white"
                        android:gravity="center_vertical"/>
                </LinearLayout>
                <!--2nd Artist END-->


                <!--3rd Artist START-->
                <LinearLayout
                    android:id="@+id/artist3Container"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:padding="8dp">

                    <de.hdodenhof.circleimageview.CircleImageView
                        android:id="@+id/artist3Pic"
                        android:layout_width="50dp"
                        android:layout_height="50dp"
                        android:src="@drawable/profile_pic_placeholder"
                        app:civ_border_color="@android:color/white"
                        app:civ_border_width="2dp"/>

                    <TextView
                        android:id="@+id/artist3Name"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="12dp"
                        android:text="Clairo"
                        android:textSize="14sp"
                        android:textColor="@android:color/white"
                        android:gravity="center_vertical"/>
                </LinearLayout>
                <!--3rd Artist END-->
            </LinearLayout>
            <!-- Top 3 Artists END -->
        </LinearLayout>
        <!-- Top 3 Songs & Artists END -->


    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>