<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/background"
    tools:context=".Fragment.CreateFragment">

    <!-- Search Songs Button at the Top -->
    <Button
        android:id="@+id/btn_open_search"
        android:layout_width="215dp"
        android:layout_height="65dp"
        android:layout_marginTop="30dp"
        android:text="Search Songs"
        android:textSize="20sp"
        android:backgroundTint="@color/blue_logo"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Centered Song Image -->
    <ImageView
        android:id="@+id/selected_song_image"
        android:layout_width="250dp"
        android:layout_height="250dp"
        android:layout_marginTop="124dp"
        android:scaleType="centerCrop"
        android:src="@drawable/snoopypfp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.538"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <!-- Song Name TextView -->

    <!-- Artist Name TextView -->

    <!-- Caption TextField (Newly Added) -->
    <!-- Added constraint to avoid floating -->

    <!-- Test TextView for Artist Search -->

    <TextView
        android:id="@+id/selected_song_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Song Name"
        android:textColor="@android:color/white"
        android:textSize="24dp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/selected_song_image" />

    <TextView
        android:id="@+id/selected_artist_name"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        android:text="Song Artist"
        android:textColor="@android:color/white"
        android:textSize="20sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/selected_song_name" />

    <EditText
        android:id="@+id/caption_input"
        android:layout_width="275dp"
        android:layout_height="116dp"
        android:layout_marginTop="24dp"
        android:background="@color/button_color"
        android:hint="Write a caption!"
        android:imeOptions="actionDone"
        android:inputType="text"
        android:maxLength="80"
        android:padding="12dp"
        android:textColor="@android:color/white"
        android:textColorHint="@android:color/white"
        android:textSize="18sp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/selected_artist_name"
        app:layout_constraintVertical_bias="0.0" />

    <Button
        android:id="@+id/btn_clear"
        android:layout_width="130dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="56dp"
        android:layout_marginTop="28dp"
        android:backgroundTint="@color/grey"
        android:text="Clear"
        android:textColor="@android:color/white"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/caption_input" />

    <Button
        android:id="@+id/btn_post"
        android:layout_width="130dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="28dp"
        android:backgroundTint="@color/grey"
        android:enabled="false"
        android:text="Post"
        android:textColor="@android:color/white"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.775"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/caption_input" />

</androidx.constraintlayout.widget.ConstraintLayout>
