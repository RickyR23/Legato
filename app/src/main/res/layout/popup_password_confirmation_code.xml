<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="350dp"
    android:layout_height="wrap_content"
    android:background="@drawable/layout_bg"
    android:layout_gravity="center"
    android:padding="16dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="4dp">

        <!-- missing content description but that should just be composed of what the ImageButton is for, for ADA req.-->
        <ImageButton
            android:id="@+id/popup_exit_button"
            android:layout_width="45dp"
            android:layout_height="45dp"
            android:layout_gravity="top|end"
            android:background="@color/white"
            app:srcCompat="@android:drawable/ic_menu_close_clear_cancel" />


        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:gravity="center"
            android:textStyle="bold"
            android:padding="8dp"
            android:lineSpacingMultiplier="1.1"
            android:text="Please enter confirmation code\nsent to your email."/>

        <EditText
            android:id="@+id/popup_text_input"
            android:layout_width="250dp"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:paddingTop="15dp"
            android:inputType="text"
            android:hint="Code"
            android:textColor="@android:color/black"/>

        <Button
            android:id="@+id/popup_verify_button"
            android:layout_width="125dp"
            android:layout_height="50dp"
            android:layout_gravity="center"
            android:backgroundTint="@color/blue_logo"
            android:text="Verify"
            android:layout_marginTop="10dp" />



    </LinearLayout>


</LinearLayout>