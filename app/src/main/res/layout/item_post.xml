<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <!-- Background image or video -->

    <!-- Centered Album Cover (moved up slightly) -->
    <ImageView
        android:id="@+id/post_legato_background"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/background" />

    <ImageView
        android:id="@+id/album_cover"
        android:layout_width="300dp"
        android:layout_height="300dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="150dp"
        android:contentDescription="Album Cover Art"
        android:scaleType="centerCrop"
        android:src="@drawable/song_example" />

    <!-- Buttons in a horizontal row below the album cover -->
    <LinearLayout
        android:id="@+id/post_actions_container"
        android:layout_width="300dp"
        android:layout_height="80dp"
        android:layout_gravity="center_horizontal"
        android:layout_marginTop="490dp"
        android:orientation="horizontal"
        android:gravity="center"
        android:padding="8dp">

        <ImageView
            android:id="@+id/like_icon"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:src="@drawable/ic_heart"

            android:layout_marginEnd="50dp" />

        <ImageView
            android:id="@+id/comment_icon"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:src="@drawable/ic_comment"
            android:layout_marginEnd="50dp" />

        <ImageView
            android:id="@+id/spotify_icon"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:src="@drawable/spotifylogo" />
    </LinearLayout>

    <!-- Bottom-left info -->
    <LinearLayout
        android:id="@+id/post_info_container"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp"
        android:layout_gravity="bottom|start"
        android:gravity="start">

        <TextView
            android:id="@+id/username_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="username"
            android:textColor="@android:color/white"
            android:textSize="18sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/caption_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="This is a caption"
            android:textColor="@android:color/white"
            android:textSize="16sp"
            android:layout_marginTop="4dp" />

        <TextView
            android:id="@+id/music_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="🎵 Music Title - Artist"
            android:textColor="@android:color/white"
            android:textSize="14sp"
            android:layout_marginTop="4dp" />
    </LinearLayout>
</FrameLayout>
