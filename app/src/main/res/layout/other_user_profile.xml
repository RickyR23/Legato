<?xml version="1.0" encoding="utf-8"?>
<!--ScrollView enables scrolling when screen size is too small-->
<ScrollView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="@drawable/background">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fitsSystemWindows="true"
        android:padding="16dp"
        tools:context=".Activity.OtherUserProfileActivity">

        <!--Back Button-->
        <ImageButton
            android:id="@+id/backButton"
            android:layout_width="30dp"
            android:layout_height="30dp"
            android:layout_marginTop="20dp"
            android:layout_marginStart="20dp"
            android:background="@android:color/transparent"
            android:contentDescription="Back to Previous page"
            android:scaleType="fitCenter"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_bias="0.0"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:srcCompat="@drawable/arrow_back" />

        <!-- Profile Picture -->
        <de.hdodenhof.circleimageview.CircleImageView
            android:id="@+id/profilePicImageView"
            android:layout_width="110dp"
            android:layout_height="110dp"
            android:layout_marginTop="60dp"
            android:elevation="4dp"
            android:contentDescription="Profile Picture"
            android:src="@drawable/profile_pic_placeholder"
            app:civ_border_color="@color/white"
            app:civ_border_width="3dp"
            app:layout_constraintHorizontal_bias="0.5"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />


        <!-- Display Name Field -->
        <TextView
            android:id="@+id/textViewDisplayName"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Display Name"
            android:textSize="22sp"
            android:textStyle="bold"
            android:textColor="@android:color/white"
            android:gravity="center"
            app:layout_constraintTop_toBottomOf="@id/profilePicImageView"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

        <!-- Bio -->
        <TextView
            android:id="@+id/textViewBio"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="bio goes here"
            android:textSize="12sp"
            android:textColor="@android:color/white"
            android:gravity="center"
            android:layout_marginTop="6dp"
            app:layout_constraintTop_toBottomOf="@id/textViewDisplayName"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintWidth_percent="0.5"/>

        <!-- Followers and Following Section -->
        <LinearLayout
            android:id="@+id/followSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="10dp"
            app:layout_constraintTop_toBottomOf="@id/textViewBio"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <!-- Followers Section -->
            <LinearLayout
                android:id="@+id/followersContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginEnd="20dp">

                <TextView
                    android:id="@+id/followersCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textStyle="bold"
                    android:textSize="18sp"
                    android:textColor="@android:color/white" />

                <TextView
                    android:id="@+id/followersLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Followers"
                    android:textSize="15sp"
                    android:textColor="@android:color/white" />
            </LinearLayout>


            <!-- Following Section -->
            <LinearLayout
                android:id="@+id/followingContainer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:gravity="center"
                android:clickable="true"
                android:focusable="true"
                android:layout_marginStart="20dp">

                <TextView
                    android:id="@+id/followingCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="0"
                    android:textStyle="bold"
                    android:textSize="18sp"
                    android:textColor="@android:color/white" />

                <TextView
                    android:id="@+id/followingLabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Following"
                    android:textSize="15sp"
                    android:textColor="@android:color/white" />
            </LinearLayout>
        </LinearLayout>

        <!-- Spotify Button -->
        <Button
            android:id="@+id/buttonProfileSpotify"
            android:layout_width="110dp"
            android:layout_height="40dp"
            android:layout_marginTop="10dp"
            android:backgroundTint="@color/spotify2"
            android:textColor="@color/black"
            android:text="Spotify"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/followSection"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintHorizontal_bias="0.25"
            app:layout_constraintWidth_percent="0.25"/>

        <!-- Follow Button -->
        <Button
            android:id="@+id/followButton"
            android:layout_width="110dp"
            android:layout_height="40dp"
            android:backgroundTint="#C9FBFBFB"
            android:layout_marginTop="10dp"
            android:text="Follow"
            android:textSize="14sp"
            android:textColor="@android:color/black"
            app:layout_constraintHorizontal_bias="0.25"
            app:layout_constraintWidth_percent="0.25"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@id/buttonProfileSpotify"
            app:layout_constraintTop_toBottomOf="@id/followSection" />


        <!-- Song of the Day STARTS-->
        <LinearLayout
            android:id="@+id/containerSongOfTheDay"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="8dp"
            android:layout_marginTop="25dp"
            app:layout_constraintTop_toBottomOf="@id/buttonProfileSpotify"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintWidth_percent="0.875">

            <!-- Text Information -->
            <LinearLayout
                android:layout_height="wrap_content"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_height="wrap_content"
                    android:layout_width="wrap_content"
                    android:text="Song of the Day"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@android:color/white"/>

                <TextView
                    android:id="@+id/textViewSongOfTheDayArtist"
                    android:layout_height="wrap_content"
                    android:layout_width="wrap_content"
                    android:text="Mac Miller"
                    android:textSize="14sp"
                    android:textColor="@android:color/white"
                    android:gravity="center"/>
                <TextView
                    android:id="@+id/textViewSongOfTheDaySong"
                    android:layout_height="wrap_content"
                    android:layout_width="wrap_content"
                    android:text="Jet Fuel"
                    android:textSize="14sp"
                    android:textColor="@android:color/white"
                    android:gravity="center"/>
            </LinearLayout>

            <!-- Album Cover Image -->
            <ImageView
                android:id="@+id/songOfTheDayAlbumCover"
                android:layout_width="55dp"
                android:layout_height="55dp"
                android:src="@drawable/song_example"
                android:layout_gravity="center_vertical"
                android:layout_marginRight="20dp"/>
        </LinearLayout>
        <!-- Song of the Day ENDS-->


        <!-- Currently Playing STARTS-->
        <LinearLayout
            android:id="@+id/containerCurrentlyPlaying"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="8dp"
            android:layout_marginTop="10dp"
            app:layout_constraintTop_toBottomOf="@id/containerSongOfTheDay"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintWidth_percent="0.875">

            <!-- Text Information -->
            <LinearLayout
                android:layout_height="wrap_content"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_height="wrap_content"
                    android:layout_width="wrap_content"
                    android:text="Currently Playing"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    android:textColor="@android:color/white"/>

                <TextView
                    android:id="@+id/textViewCurrentlyPlayingArtist"
                    android:layout_height="wrap_content"
                    android:layout_width="wrap_content"
                    android:text="Feid"
                    android:textSize="14sp"
                    android:textColor="@android:color/white"/>
                <TextView
                    android:id="@+id/textViewCurrentlyPlayingSong"
                    android:layout_height="wrap_content"
                    android:layout_width="wrap_content"
                    android:text="FELIZ CUMPLEAÑOS FERXXO"
                    android:textSize="14sp"
                    android:textColor="@android:color/white"/>
            </LinearLayout>

            <!-- Album Cover Image -->
            <ImageView
                android:id="@+id/currentlyPlayingAlbumCover"
                android:layout_width="55dp"
                android:layout_height="55dp"
                android:src="@drawable/currently_example"
                android:layout_gravity="center_vertical"
                android:layout_marginRight="20dp"/>
        </LinearLayout>
        <!-- Currently Playing ENDS-->


        <!-- Top Artists Label START -->
        <TextView
            android:id="@+id/topArtistsLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Top 3 Artists"
            android:textColor="@color/white"
            android:textStyle="bold"
            android:textSize="18sp"
            android:padding="8dp"
            android:layout_marginTop="30dp"
            app:layout_constraintStart_toStartOf="@id/containerCurrentlyPlaying"
            app:layout_constraintTop_toBottomOf="@id/containerCurrentlyPlaying" />
        <!-- Top Artists Label END -->


        <!--Top 3 Artists Section START-->
        <LinearLayout
            android:id="@+id/topArtistsSection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:padding="3dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/topArtistsLabel"
            app:layout_constraintWidth_percent="0.875">

            <!-- ARTIST 1 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">
                <include
                    android:id="@+id/artistCard1"
                    layout="@layout/item_artist_card_profile" />
            </LinearLayout>

            <!-- ARTIST 2 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">
                <include
                    android:id="@+id/artistCard2"
                    layout="@layout/item_artist_card_profile" />
            </LinearLayout>

            <!-- ARTIST 3 -->
            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:orientation="vertical">
                <include
                    android:id="@+id/artistCard3"
                    layout="@layout/item_artist_card_profile" />
            </LinearLayout>

        </LinearLayout>
        <!--Top 3 Artists Section END-->


        <!-- Top 3 Songs Section START -->
        <LinearLayout
            android:id="@+id/topSongsSection"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:gravity="center_vertical"
            android:layout_marginTop="30dp"
            app:layout_constraintWidth_percent="0.9"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toBottomOf="@id/topArtistsSection">

            <!--Display Top songs Label-->
            <TextView
                android:id="@+id/editTopSongsTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Top 3 Songs"
                android:textColor="@color/white"
                android:textStyle="bold"
                android:textSize="18sp"
                android:padding="10dp"/>

            <!--Song 1-->
            <include
                android:id="@+id/songCard1"
                layout="@layout/item_song_card_profile"/>

            <!--Song 2-->
            <include
                android:id="@+id/songCard2"
                layout="@layout/item_song_card_profile"/>

            <!--Song 3-->
            <include
                android:id="@+id/songCard3"
                layout="@layout/item_song_card_profile"/>

        </LinearLayout>
        <!-- Top 3 Songs END -->

    </androidx.constraintlayout.widget.ConstraintLayout>
</ScrollView>