<resources xmlns:tools="http://schemas.android.com/tools">
    <!-- Night mode theme overrides -->
    <style name="Theme.LegatoApp" parent="Theme.MaterialComponents.DayNight.NoActionBar">
        <!-- Darker nav bar and card colors -->
        <item name="android:navigationBarColor">#000000</item> <!-- or your dark color -->
        <item name="android:statusBarColor">#000000</item>

        <item name="colorSurface">#2A2A2A</item> <!-- lighter than black -->

        <!-- Lighten hint/text colors if needed -->
        <item name="android:textColorHint">#AAAAAA</item>
        <item name="android:textColorPrimary">#FFFFFF</item>

        <item name="android:windowLightStatusBar">false</item>

        <!-- Custom style for CardView -->
        <item name="materialCardViewStyle">@style/NightCardStyle</item>

        <!-- Disable all caps globally for all buttons -->
        <item name="android:textAllCaps">false</item>

        <!-- Fix letter spacing -->
        <item name="android:letterSpacing">0</item>
    </style>

    <style name="NightCardStyle" parent="Widget.MaterialComponents.CardView">
        <item name="cardBackgroundColor">#1E1E1E</item>
        <item name="cardElevation">4dp</item>
        <item name="cardCornerRadius">16dp</item>
    </style>

    <color name="report1">#FFFFFF</color>
    <color name="report2">#BBBBBB</color>
</resources>
